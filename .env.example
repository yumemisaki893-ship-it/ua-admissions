# ------------------------------------------------------------------
# University of Antique - Student Information & Admission System
# Copy this file to `.env` and fill in the values.
# Never commit the real `.env` file.
# ------------------------------------------------------------------

# --- Database (PostgreSQL) -----------------------------------------
DATABASE_URL="postgresql://ua_app:ua_app_password@localhost:5432/ua_admission?schema=public"

# --- NextAuth.js (Auth.js) ------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Only needed if you want Google Sign-In.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudinary (file uploads) ---------------------------------------
# https://cloudinary.com/console -> Account Details
# If left blank, uploaded files are stored locally under /public/uploads
# (development fallback only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- PayMongo (application fee) --------------------------------------
# https://dashboard.paymongo.com/developers
# If left blank, the app runs in "simulated payment" mode so the
# admission flow can be tested end-to-end locally.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
APPLICATION_FEE_PHP="500"

# --- Upstash (rate limiting) ------------------------------------------
# https://console.upstash.com/redis
# If left blank, an in-memory limiter is used (development only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Seed admin account ------------------------------------------------
# Used by `npm run db:seed` to create the initial admin user.
SEED_ADMIN_EMAIL="admin@universityofantique.edu.ph"
SEED_ADMIN_PASSWORD="Admin12345!"

# --- Public env (safe to expose) ----------------------------------------
# Map embed query (optional)
NEXT_PUBLIC_MAP_EMBED_URL="https://maps.google.com/maps?q=University%20of%20Antique%2C%20Sibalom%2C%20Antique&t=&z=14&ie=UTF8&iwloc=&output=embed"
